# Ozon Seller API（有 Key 时填；没有则走连接器免密钥路径）
OZON_CLIENT_ID=
OZON_API_KEY=

# 部署鉴权令牌（前端「自建部署」页填写；留空则首次启动自动生成并打印到日志）
DEPLOY_TOKEN=

# 跨域来源（GitHub Pages 等静态托管访问本 API 时填写，多个用逗号分隔；同源部署可留空）
ALLOW_ORIGIN=

# 服务端口
PORT=8787

# 是否允许写操作代理（1=允许发货/运单等；0=只读）
WRITE_ALLOW=1

# 可选：要求连接器 ingest 必须带 Bearer 令牌
# REQUIRE_INGEST_TOKEN=0
