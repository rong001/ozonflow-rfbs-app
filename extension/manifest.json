{
  "manifest_version": 3,
  "name": "OzonFlow 连接器",
  "version": "1.1.0",
  "description": "免 Api-Key：在已登录的 Ozon 卖家后台捕获订单/结算/商品，辅助发货/回传运单/面单，采集公开价格与轨迹，并推送经营简报。",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://seller.ozon.ru/*",
    "https://www.ozon.ru/*",
    "https://docs.ozon.ru/*",
    "https://www.wildberries.ru/*",
    "https://search.wb.ru/*",
    "https://global.cainiao.com/*",
    "https://qyapi.weixin.qq.com/*",
    "https://oapi.dingtalk.com/*",
    "https://open.feishu.cn/*",
    "https://api.telegram.org/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.ozon.ru/*"
      ],
      "js": [
        "capture-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://seller.ozon.ru/*"
      ],
      "js": [
        "capture-relay.js",
        "seller-write.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.ozon.ru/*",
        "https://www.wildberries.ru/*"
      ],
      "js": [
        "normalize.js",
        "market.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rong001.github.io/ozonflow-rfbs-app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:8787/*",
        "http://127.0.0.1:8787/*",
        "https://localhost:8787/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "OzonFlow 连接器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
